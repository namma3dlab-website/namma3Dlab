c:["$","main",null,{"style":{"background":"var(--paper)","minHeight":"100vh","paddingTop":"28px"},"children":[["$","$L1f",null,{"product":{"id":"prod-lamp","slug":"voronoi-ambient-desk-lamp","name":"Voronoi Ambient Desk Lamp","category":"decor","price":1299,"originalPrice":1699,"material":"Tough PLA / Wood Composite","dimensions":"210 × 130 × 130 mm","leadTime":"48 Hours","description":"Biomorphic Voronoi cell geometry creating dramatic ambient light refraction. Includes an energy-efficient warm USB LED puck light with inline on/off toggle.","colorGradient":"linear-gradient(135deg, #16A34A, #4ADE80)","iconName":"Lamp","colors":["Wood Composite","Matte White","Charcoal"],"inStock":true,"badge":"Includes LED","rating":4.8,"reviewsCount":24,"features":["Parametric Voronoi geometric cellular lattice","Warm white 3000K USB LED puck included","Low thermal emission, safe for overnight desk use","Braided 1.5m USB cable with switch"],"specs":{"Print Technology":"High-Speed CoreXY FDM","Layer Resolution":"0.20 mm Adaptive","Material Grade":"Heat-Resistant Tough PLA","Power Supply":"5V USB Type-A (Universal)","Cable Length":"1.5 Meters Braided"}},"relatedProducts":[{"id":"prod-vase","slug":"geometric-spiral-fluted-vase","name":"Geometric Spiral Fluted Vase","category":"decor","price":449,"originalPrice":599,"material":"Silk PLA+","dimensions":"180 × 110 × 110 mm","leadTime":"24 Hours","description":"Watertight parametric vase with spiral ribbing and metallic silk shimmer reflection. Crafted using continuous single-perimeter vase mode for flawless layer transition without seam lines.","colorGradient":"linear-gradient(135deg, #0284C7, #38BDF8)","iconName":"Feather","colors":["Silk Gold","Arctic Silver","Emerald Green","Matte Black"],"inStock":true,"badge":"Bestseller","rating":4.9,"reviewsCount":38,"features":["Watertight single-perimeter spiral extrusion","Reflective metallic silk finish","Includes silicone non-scratch desk pads","Optimized for dried botanicals and fresh stems"],"specs":{"Print Technology":"FDM (Fused Deposition Modeling)","Layer Resolution":"0.16 mm Ultra-Smooth","Material Grade":"Silk PLA+ Biopolymer","Net Weight":"145 grams","Waterproof":"Yes (Hydrostatic tested 24h)"}},{"id":"prod-idol","slug":"intricate-cultural-deity-idol","name":"Intricate Cultural Deity Idol","category":"idols","price":799,"originalPrice":1099,"material":"Ultra-Fine SLA Resin","dimensions":"120 × 75 × 65 mm","leadTime":"24–48 Hours","description":"Museum-grade 0.05mm layer resolution with antique bronze cured acrylic finish. Printed on 8K monochrome LCD resin engines to capture microscopic facial features and intricate ornaments.","colorGradient":"linear-gradient(135deg, #D97706, #FBBF24)","iconName":"Sun","colors":["Antique Bronze","Marble White","Obsidian Gold"],"inStock":true,"badge":"8K Ultra Detail","rating":5,"reviewsCount":52,"features":["8K High-Definition MSLA Resin curing","0.05 mm invisible layer lines","Post-cured in dual-wavelength UV chambers","Hand-finished antique bronze patina"],"specs":{"Print Technology":"SLA / MSLA (Photopolymer Resin)","Layer Resolution":"0.05 mm (50 Microns)","Material Grade":"High-Impact Engineering Tough Resin","Net Weight":"180 grams solid","Surface Finish":"Matte Acrylic Sealed"}},{"id":"prod-keychain","slug":"bespoke-dual-tone-keychains","name":"Bespoke Dual-Tone Keychains","category":"gifts","price":199,"originalPrice":299,"material":"PETG Impact Resistant","dimensions":"70 × 24 × 5 mm","leadTime":"Same Day","description":"Industrial dual-color fused typography. Impervious to pocket wear, car keys, and water. Perfect everyday carry accessory or personalized token.","colorGradient":"linear-gradient(135deg, #DB2777, #F472B6)","iconName":"Key","colors":["Black / Neon Lime","Navy / White","Red / Black"],"inStock":true,"badge":"Same Day Dispatch","rating":4.9,"reviewsCount":89,"features":["Dual-extrusion lettering fused into the base (not painted)","Includes stainless steel split ring and carabiner","Impact-proof PETG polymer construction","Scratch and water resistant"],"specs":{"Print Technology":"Multi-Material FDM Co-extrusion","Layer Resolution":"0.12 mm Fine","Material Grade":"PETG Copolymer","Hardware":"304 Stainless Steel Ring","Weight":"18 grams"}}]}],"$L20"]}]
