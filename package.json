{
  "name": "namma-3d-lab-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "website",
    "admin",
    "pos"
  ],
  "scripts": {
    "dev": "next dev -p 3003",
    "dev:website": "npm run dev --prefix website",
    "dev:admin": "npm run dev --prefix admin",
    "dev:pos": "npm run dev --prefix pos",
    "build": "next build",
    "build:website": "npm run build --prefix website",
    "build:admin": "npm run build --prefix admin",
    "build:pos": "npm run build --prefix pos",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5"
  }
}
